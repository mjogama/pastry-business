DATABASE_URL=<YOUR_DATABASE_URL>
# Neon only: the direct (non -pooler) URL, used by Prisma migrations. Leave unset for local Postgres.
DATABASE_URL_UNPOOLED=<YOUR_DIRECT_DATABASE_URL>
BASE_URL=<YOUR_FRONTEND_URL>

NODE_ENV=development
HOST=0.0.0.0
PORT=8001
TRUST_PROXY=false

BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
