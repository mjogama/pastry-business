DATABASE_URL=<YOUR_DATABASE_URL>
DATABASE_URL_UNPOOLED=<YOUR_DIRECT_DATABASE_URL>
BASE_URL=<YOUR_FRONTEND_URL>

NODE_ENV=development
HOST=0.0.0.0
PORT=8001
TRUST_PROXY=false

BODY_LIMIT=100kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

JWT_ACCESS_SECRET=<YOUR_ACCESS_KEY>
JWT_REFRESH_SECRET=<YOUR_REFRESH_ACCESS_KEY>
# Optional. Unset = tokens never expire.
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000

CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>
CLOUDINARY_FOLDER=<YOUR_FOLDER>
