{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/server/**"]
  },
  "deploy": {
    "preDeployCommand": ["npm run migrate:deploy"],
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
