pipeline {
    agent any

    tools {
        nodejs("Node 22")
    }

    environment {
        SERVER_IP    = credentials('SERVER_IP')
        IMAGE_NAME   = 'mjogama/pato-business'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        PROJECT_PATH = '/home/mjogama/personal-project/pastry-business/server-docker'
    }

    stages {

        stage('Github Clone') {
            steps {
                checkout scmGit(
                    branches: [[name: '*/main']],
                    extensions: [],
                    userRemoteConfigs: [[
                        credentialsId: 'JENKINS_GITHUB_PRIVATE_KEY_MJOGAMA',
                        url: 'git@github.com:mjogama/pastry-business.git'
                    ]]
                )
            }
        }

        stage('Install Dependencies + Build') {
            steps {
                dir('server') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Database Migration') {
            steps {
                // Prisma client is generated by `npm run build`. Use Neon's direct (unpooled) URL here.
                withCredentials([string(credentialsId: 'PATO_BUSINESS_DATABASE_URL', variable: 'DATABASE_URL')]) {
                    dir('server') {
                        sh 'npm run migrate:deploy'
                    }
                }
            }
        }

        stage('Server Testing') {
            steps {
                dir('server') {
                    sh 'npm run test'
                }
            }
        }

        stage('Copy Docker compose and Nginx') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'UBUNTU_SERVER_SSH_KEY',
                    keyFileVariable: 'UBUNTU_SSH_KEY',
                    usernameVariable: 'UBUNTU_USERNAME'
                )]) {
                    sh '''
                        # Everything lives under the project folder so it never
                        # collides with another project's deploy-docker.sh.
                        ssh -i "$UBUNTU_SSH_KEY" \
                            "$UBUNTU_USERNAME@$SERVER_IP" \
                            "mkdir -p $PROJECT_PATH/scripts $PROJECT_PATH/temp"

                        scp -i "$UBUNTU_SSH_KEY" \
                            ./server/server/scripts/deploy-docker.sh \
                            "$UBUNTU_USERNAME@$SERVER_IP:$PROJECT_PATH/scripts/"

                        ssh -i "$UBUNTU_SSH_KEY" \
                            "$UBUNTU_USERNAME@$SERVER_IP" \
                            "chmod +x $PROJECT_PATH/scripts/deploy-docker.sh"

                        scp -i "$UBUNTU_SSH_KEY" \
                            ./server/server/docker/docker-compose.yml \
                            "$UBUNTU_USERNAME@$SERVER_IP:$PROJECT_PATH"

                        scp -i "$UBUNTU_SSH_KEY" \
                            ./server/server/nginx/pato-business-production.conf \
                            ./server/server/nginx/pato-business-staging.conf \
                            "$UBUNTU_USERNAME@$SERVER_IP:$PROJECT_PATH/temp"

                        ssh -i "$UBUNTU_SSH_KEY" \
                            "$UBUNTU_USERNAME@$SERVER_IP" \
                            "sudo mv $PROJECT_PATH/temp/pato-business-production.conf /etc/nginx/sites-available/pato-business-production && \
                            sudo mv $PROJECT_PATH/temp/pato-business-staging.conf /etc/nginx/sites-available/pato-business-staging && \
                            sudo ln -sfn /etc/nginx/sites-available/pato-business-production /etc/nginx/sites-enabled/pato-business-production && \
                            sudo ln -sfn /etc/nginx/sites-available/pato-business-staging /etc/nginx/sites-enabled/pato-business-staging && \
                            sudo nginx -t && \
                            sudo systemctl reload nginx"
                    '''
                }
            }
        }

        stage('Login to Docker') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'DOCKER_HUB_CREDS',
                    passwordVariable: 'DOCKER_PSW',
                    usernameVariable: 'DOCKER_USR'
                )]) {
                    sh 'echo "$DOCKER_PSW" | docker login -u "$DOCKER_USR" --password-stdin'
                }
            }
        }

        stage('Docker Build + Push') {
            steps {
                dir('server') {
                    sh '''
                        docker build -t $IMAGE_NAME:$IMAGE_TAG .
                        docker push $IMAGE_NAME:$IMAGE_TAG
                    '''
                }
            }
        }

        stage('Nginx revalidate') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'UBUNTU_SERVER_SSH_KEY',
                    keyFileVariable: 'UBUNTU_SSH_KEY',
                    usernameVariable: 'UBUNTU_USERNAME'
                )]) {
                    sh '''
                        ssh -i "$UBUNTU_SSH_KEY" "$UBUNTU_USERNAME@$SERVER_IP" \
                            "sudo nginx -t && sudo systemctl reload nginx"
                    '''
                }
            }
        }

        stage('SSH To Server + Docker Pull') {
            steps {
                withCredentials([sshUserPrivateKey(
                    credentialsId: 'UBUNTU_SERVER_SSH_KEY',
                    keyFileVariable: 'UBUNTU_SSH_KEY',
                    usernameVariable: 'UBUNTU_USERNAME'
                )]) {
                    sh '''
                        ssh -i "$UBUNTU_SSH_KEY" "$UBUNTU_USERNAME@$SERVER_IP" \
                            "IMAGE_TAG=$IMAGE_TAG $PROJECT_PATH/scripts/deploy-docker.sh"
                    '''
                }
            }
        }
    }

    post {
        always  { echo '===== Pipeline Finished ====='; sh 'docker logout' }
        success { echo '===== Pipeline Successful =====' }
        failure { echo '===== Pipeline Failed =====' }
        cleanup { echo '===== Cleaning Jenkins Workspace ====='; deleteDir() }
    }
}
