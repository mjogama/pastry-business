{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.ts", "**/*.tsx", "*.json", "!next-env.d.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["app/**", "features/**", "components/**", "!components/ui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "button": "Use Button from @/components/ui/button (or a feature wrapper built on it).",
                  "input": "Use Input from @/components/ui/input.",
                  "textarea": "Use Textarea from @/components/ui/textarea.",
                  "label": "Use Label from @/components/ui/label.",
                  "dialog": "Use Dialog, Sheet or Drawer from @/components/ui."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**", "!lib/utils.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "cn": "Import cn from @/lib/utils: it knows the app's custom theme scales. The bare package drops custom classes such as text-cell.",
                  "cn/config": "Only lib/utils.ts configures cn."
                }
              }
            }
          }
        }
      }
    }
  ]
}
